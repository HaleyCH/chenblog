---
import Encrypt from "./Encrypt.astro";
import StringWrapper from "./StringWrapper.astro";
export interface Props {
  password?: string;
}

const password = Astro.props.password;
---

{
  !password ? (
    <slot />
  ) : (
    <Encrypt password={password}>
      <StringWrapper>
        <slot />
      </StringWrapper>
    </Encrypt>
  )
}
